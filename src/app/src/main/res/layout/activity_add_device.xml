<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include android:id="@+id/include" layout="@layout/include_toolbar" />
    <TextView android:id="@+id/list_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingTop="18dp" android:paddingBottom="8dp"
        android:textSize="13sp" android:textColor="@color/text_second_color_primary" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/device_filters"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp">
        <com.google.android.material.chip.Chip android:id="@+id/filter_named"
            style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="隐藏无名称" />
        <com.google.android.material.chip.Chip android:id="@+id/filter_common"
            style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="仅常用" />
    </com.google.android.material.chip.ChipGroup>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include layout="@layout/inclue_recyclerview" />
        <TextView android:id="@+id/empty_devices" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginHorizontal="32dp" android:layout_marginBottom="64dp"
            android:gravity="center" android:lineSpacingExtra="8dp" android:textSize="15sp"
            android:textColor="@color/text_second_color_primary" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
